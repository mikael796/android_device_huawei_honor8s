# Honor 8S (MT6761) TWRP fstab
# Block devices: /dev/block/platform/bootdevice/by-name/* (eMMC GPT)

# ---------------- storage mounts ----------------
/dev/block/platform/bootdevice/by-name/system        /system       ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/vendor        /vendor       ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/product       /product      ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/version       /version      ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/odm           /odm          ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/cust          /cust         ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/cache         /cache        ext4      defaults    flags=backup=1;display="Cache"
/dev/block/platform/bootdevice/by-name/userdata      /data         f2fs      defaults    flags=backup=1;length=-16384;formattable;display="Data"
/dev/block/platform/bootdevice/by-name/log           /log          ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/nvdata        /nvdata       ext4      defaults    defaults

# ---------------- microSD (removable) ----------------
/dev/block/mmcblk1p1                                 /sdcard       vfat      defaults    flags=display="microSD";storage;removable

# ---------------- USB OTG ----------------
/devices/platform/mt_usb*                            /usb_otg      auto      defaults    voldmanaged=usbotg:auto
/devices/platform/externdevice*                      /external_sd  auto      defaults    voldmanaged=sdcard1:auto

# ---------------- flashable partitions ----------------
/dev/block/platform/bootdevice/by-name/boot         /boot                 emmc      defaults    flags=backup=1;display="Boot"
/dev/block/platform/bootdevice/by-name/recovery     /recovery             emmc      defaults    flags=backup=1;display="Recovery"
/dev/block/platform/bootdevice/by-name/recovery_ramdisk /recovery_ramdisk emmc      defaults    flags=backup=1;display="Recovery ramdisk"
/dev/block/platform/bootdevice/by-name/recovery_vendor /recovery_vendor   emmc      defaults    flags=backup=1;display="Recovery vendor"
/dev/block/platform/bootdevice/by-name/misc         /misc                 emmc      defaults    flags=display="Misc"
/dev/block/platform/bootdevice/by-name/vbmeta       /vbmeta               emmc      defaults    flags=display="Vbmeta"
/dev/block/platform/bootdevice/by-name/dtbo         /dtbo                 emmc      defaults    flags=display="Dtbo"
/dev/block/platform/bootdevice/by-name/dtbo1        /dtbo1                emmc      defaults    flags=display="Dtbo1"
/dev/block/platform/bootdevice/by-name/dtbo2        /dtbo2                emmc      defaults    flags=display="Dtbo2"
/dev/block/platform/bootdevice/by-name/lk           /bootloader           emmc      defaults    flags=display="LK"
/dev/block/platform/bootdevice/by-name/lk2          /bootloader2          emmc      defaults    flags=display="LK2"
/dev/block/platform/bootdevice/by-name/logo         /logo                 emmc      defaults    flags=display="Logo"
/dev/block/platform/bootdevice/by-name/frp          /persistent           emmc      defaults    flags=display="FRP"
/dev/block/platform/bootdevice/by-name/nvram        /nvram                emmc      defaults    flags=display="Nvram"
/dev/block/platform/bootdevice/by-name/proinfo      /proinfo              emmc      defaults    flags=display="Proinfo"
/dev/block/platform/bootdevice/by-name/seccfg      /seccfg               emmc      defaults    flags=display="Seccfg"
/dev/block/platform/bootdevice/by-name/expdb        /expdb                emmc      defaults    flags=display="Expdb"
/dev/block/platform/bootdevice/by-name/tee1         /tee1                 emmc      defaults    flags=display="Tee1"
/dev/block/platform/bootdevice/by-name/tee2         /tee2                 emmc      defaults    flags=display="Tee2"
/dev/block/platform/bootdevice/by-name/scp1         /scp1                 emmc      defaults    flags=display="Scp1"
/dev/block/platform/bootdevice/by-name/scp2         /scp2                 emmc      defaults    flags=display="Scp2"
/dev/block/platform/bootdevice/by-name/sspm_1      /sspm_1               emmc      defaults    flags=display="Sspm1"
/dev/block/platform/bootdevice/by-name/sspm_2      /sspm_2               emmc      defaults    flags=display="Sspm2"
/dev/block/platform/bootdevice/by-name/md1img      /md1img               emmc      defaults    flags=display="Modem"
/dev/block/platform/bootdevice/by-name/md1dsp      /md1dsp               emmc      defaults    flags=display="Modem dsp"
/dev/block/platform/bootdevice/by-name/md1arm7     /md1arm7              emmc      defaults    flags=display="Modem arm7"
/dev/block/platform/bootdevice/by-name/md3img      /md3img               emmc      defaults    flags=display="Modem3"
/dev/block/platform/bootdevice/by-name/spmfw       /spmfw                emmc      defaults    flags=display="Spmfw"
/dev/block/platform/bootdevice/by-name/boot_para   /boot_para            emmc      defaults    flags=display="Boot para"
/dev/block/platform/bootdevice/by-name/protect1     /protect_f            ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/protect2     /protect_s            ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/nvcfg       /nvcfg                ext4      defaults    defaults
/dev/block/platform/bootdevice/by-name/persist     /persist              ext4      defaults    defaults
